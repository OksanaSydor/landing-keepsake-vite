mixin picture(name, alt, width = 600, height = 474, lazy = true, sizes = '(min-width: 1280px) 357px, (min-width: 768px) 50vw, 100vw')
  -
    const isPost = name.startsWith('post-')
    const smallWidth = isPost ? 150 : 400
    const largeWidth = isPost ? 300 : 600

  picture
    source(
      type="image/avif"
      srcset=`/assets/images/${name}-${smallWidth}.avif ${smallWidth}w, /assets/images/${name}-${largeWidth}.avif ${largeWidth}w`
      sizes=sizes
    )

    source(
      type="image/webp"
      srcset=`/assets/images/${name}-${smallWidth}.webp ${smallWidth}w, /assets/images/${name}-${largeWidth}.webp ${largeWidth}w`
      sizes=sizes
    )

    if lazy
      img(
        src=`/assets/images/${name}-${largeWidth}.jpg`
        alt=alt
        width=width
        height=height
        loading="lazy"
        decoding="async"
      )&attributes(attributes)
    else
      img(
        src=`/assets/images/${name}-${largeWidth}.jpg`
        alt=alt
        width=width
        height=height
        fetchpriority="high"
        decoding="async"
      )&attributes(attributes)