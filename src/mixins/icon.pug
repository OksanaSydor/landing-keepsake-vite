mixin icon(name, width = 24, height = width)
  svg.icon(
    class=`icon--${name}`,
    width=width,
    height=height,
    viewBox="0 0 24 24",
    fill="none",
    stroke="currentColor",
    stroke-width="2",
    stroke-linecap="round",
    stroke-linejoin="round",
    aria-hidden="true"
  )&attributes(attributes)
    case name
      when "heart"
        path(
          d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
        )

      when "mail"
        path(d="M3 5h18v14H3z")
        path(d="m3 5 9 8 9-8")

      when "instagram"
        rect(x="3", y="3", width="18", height="18", rx="5")
        circle(cx="12", cy="12", r="4")
        circle(cx="17.5", cy="6.5", r="0.75")

      when "globe"
        circle(cx="12", cy="12", r="9")
        path(d="M3 12h18")
        path(d="M12 3c-4 5-4 13 0 18")
        path(d="M12 3c4 5 4 13 0 18")

      when "brand"
        path(d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.3l6.1-.7z")

      when "identity"
        circle(cx="12", cy="12", r="9")
        circle(cx="12", cy="12", r="3")

      when "print"
        path(d="M6 9V3h12v6M6 17H3V9h18v8h-3M6 14h12v7H6z")

      when "web"
        path(d="M3 4h18v16H3zM3 9h18")
      when "menu"
        path(d="M3 6h18M3 12h18M3 18h18")

      when "close"
        path(d="M5 5l14 14M19 5L5 19")
      when "arrow-up"
        path(d="M12 19V5")
        path(d="m5 12 7-7 7 7")
