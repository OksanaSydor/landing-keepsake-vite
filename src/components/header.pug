header.header
  .container.header__container
    include logo

    button.header__burger(
      type="button"
      popovertarget="menu"
      aria-controls="menu"
      aria-label="Open navigation"
    )
      +icon('menu', 24)(class="header__burger-icon header__burger-icon--open")
      +icon('close', 24)(class="header__burger-icon header__burger-icon--close")

    include navigation