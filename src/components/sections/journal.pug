section#journal.journal.container
  h2.section-title From the journal

  .journal-grid
    each post in journalPosts
      article.journal-card
        +picture(post.image, post.alt, 300, 300, true, '(min-width: 768px) 150px, 96px')(class="journal-card__img")

        .journal-card__content
          p.journal-card__meta
            time(datetime=post.dateTime)= post.date
            |  /
            span= post.category

          h3.journal-card__title= post.title

          p.journal-card__excerpt= post.excerpt

          a.journal-card__link(href="#") Read more