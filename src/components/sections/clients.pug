section#clients.clients
  .container
    h2.section-title Clients & kind words

    ul.clients__logos(aria-label="Our clients")
      each client in clientLogos
        li.clients__logo= client

    .clients__quote
      figure
        span.clients__quote-mark(aria-hidden="true") “

        blockquote
          p= testimonial.quote

        figcaption.clients__author
          span.clients__avatar(aria-hidden="true")= testimonial.initials

          span.clients__details
            strong= testimonial.name
            br
            = testimonial.position

      .clients__dots(aria-hidden="true")
        span.clients__dot.clients__dot--active
        span.clients__dot
        span.clients__dot
