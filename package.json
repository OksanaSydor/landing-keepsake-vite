{
  "name": "landing-keepsake-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^1.0.14",
    "autoprefixer": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "sass": "^1.77.8",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^5.3.4",
    "vituum": "^1.0.14"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  }
